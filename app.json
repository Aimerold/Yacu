{
  "expo": {
    "name": "Yacu",
    "slug": "Yacu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/aimerold.png",
    "scheme": "yacu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/aimerold.png"
    },
    "android": {
      "package": "yacu.com.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/aimerold.png",
        "backgroundImage": "./assets/images/aimerold.png",
        "monochromeImage": "./assets/images/aimerold.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/aimerold.png"
    },

    
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/aimerold.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#208AEF",
          "defaultChannel": "messages"
        }
      ]
    ],


    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8ecacae9-06fd-4fd5-84cd-58a99acf62ee"
      }
    }
  }
}
